#PAN VERIFICATION USING REGEX MODULE
import re
def check_pan(pan):
    pattern=r'^[A-Z]{5}[0-9]{4}[A-Z]$'
    if re.match(pattern,pan):
        print("valid PAN format")
    else:
        print("Invalid PAN id format")
pan=input("Enter your correct PAN No.")
check_pan(pan)     

